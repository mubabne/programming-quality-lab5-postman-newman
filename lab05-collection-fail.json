      "name": "01 Happy path - идэвхтэй оюутан бүртгүүлэх",
      "item": [
        {
          "name": "Setup student B250001",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"status\":\"active\",\"coursesTaken\":[\"CS201\"]}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/students/B250001"
          }
        },
        {
          "name": "Setup course CS501",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"prerequisites\":[\"CS201\"]}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/courses/CS501"
          }
        },
        {
          "name": "Амжилттай бүртгэл 201 OK",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Зориуд буруу: статус 200', () => pm.response.to.have.status(200));",
                  "pm.test('result нь OK', () => pm.expect(pm.response.json().result).to.eql('OK'));",
                  "pm.test('registrationID нь тоо', () => pm.expect(pm.response.json().registrationID).to.be.a('number'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"studentID\":\"B250001\",\"courseID\":\"CS501\"}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/registrations"
          }
        }
      ]
